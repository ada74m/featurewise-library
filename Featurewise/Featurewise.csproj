<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <!-- The package. CI sets VersionSuffix to preview.<run>; local packs are 0.1.0-dev. -->
    <PropertyGroup>
        <PackageId>Featurewise.Core</PackageId>
        <VersionPrefix>0.1.0</VersionPrefix>
        <VersionSuffix Condition="'$(VersionSuffix)' == ''">dev</VersionSuffix>
        <Authors>Adam Rambridge</Authors>
        <Description>Structures a service as features (commands, queries and event handlers) invoked through links: records that name a feature and carry its arguments. One pipeline invokes every feature, with the same scope, authorization, logging, tracing and cancellation.</Description>
        <PackageTags>features;links;cqrs;hateoas;authorization</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <RepositoryUrl>https://github.com/ada74m/featurewise</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <!-- Symbols travel in the assembly, since GitHub Packages takes no symbol packages; Source Link
             points debuggers at the commit's sources on GitHub. -->
        <DebugType>embedded</DebugType>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Authorization" Version="10.0.12"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12"/>
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.12"/>
    </ItemGroup>

</Project>
