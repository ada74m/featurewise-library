<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <!-- The package a service's core references: what features, links and rules are written with. -->
    <PropertyGroup>
        <PackageId>Featurewise.Core</PackageId>
        <Description>Structures a service as features (commands, queries and event handlers) invoked through links: records that name a feature and carry its arguments. This package holds what a service's core is written with: features, links, rules and the invocation's context. Its entrypoints invoke features with Featurewise.Hosting.</Description>
        <PackageTags>features;links;cqrs;hateoas;authorization</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <!-- Featurewise.Hosting creates each invocation's Invocation and LinkPermissions, which nothing else may. -->
    <ItemGroup>
        <InternalsVisibleTo Include="Featurewise.Hosting" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Authorization" Version="10.0.12"/>
    </ItemGroup>

</Project>
